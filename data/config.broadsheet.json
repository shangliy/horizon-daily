{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0.5,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 4,
    "enrichment_concurrency": 4
  },
  "broadsheet": {
    "enabled": true,
    "titles": {
      "zh": "地平线每日快报",
      "en": "Horizon Daily"
    },
    "copy_to_docs": true,
    "site_dir": "docs/broadsheet",
    "default_language": "zh"
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.5,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "category": "dev-tools",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 120,
      "category": "ai-news",
      "profile": "tech-news"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [],
      "min_stars": 20,
      "max_items": 10,
      "category": "open-source",
      "profile": "tech-blog"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "NVIDIA CUDA Blog",
        "url": "https://developer.nvidia.com/blog/tag/cuda/feed/",
        "enabled": true,
        "category": "cuda",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Tech",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=19854910",
        "enabled": true,
        "category": "tech-markets",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "category": "ml-research",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "category": "llm-local",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 15,
          "category": "tech-flash",
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "group_by": "profile",
    "category_groups": {
      "news": {
        "limit": 9,
        "categories": [
          "tech-news"
        ]
      },
      "blogs": {
        "limit": 6,
        "categories": [
          "tech-blog"
        ]
      },
      "finance": {
        "limit": 5,
        "categories": [
          "finance-news"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 3
  }
}
